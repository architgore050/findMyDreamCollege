# env
.env
.env.*
!.env.example

# python
__pycache__/
*.py[cod]
.venv/
.uv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# node
node_modules/
.next/
out/
.turbo/
pnpm-debug.log*

# model weights (host data under MODEL_DIR; never in the repo, an image, or a volume)
models/

# data + artifacts (never commit raw crawls or snapshots)
data/*
!data/golden/
!data/golden/**
# curated eval truth tables (docs/v1/eval/03-truth-ingestion.md): committed
# rank/grade tables + the raw page copies their sha256 provenance points at
!data/truth/
!data/truth/**
# scrape-failure log (docs/product-development-cycle/18-scrape-failures.md):
# append-only evidence of what the scraper lost to blocked/failed fetches
!data/scrape-failures/
!data/scrape-failures/**
# compute metrics (fmd/obs/metrics.py): append-only JSONL telemetry, one file
# per run_id. Host telemetry is not evidence — only the README is committed.
!data/compute-metrics/
data/compute-metrics/*
!data/compute-metrics/README.md

snapshots/
*.parquet
*.warc
*.warc.gz
packages/pipeline/tests/fixtures/llm/*.real.json

# os/editor
.DS_Store
.idea/
.vscode/
*.swp

# local patch intake
/tmp/
