# --- database ---
POSTGRES_USER=fmd
POSTGRES_PASSWORD=fmd
POSTGRES_DB=fmd
POSTGRES_PORT=5433
DATABASE_URL=postgresql://fmd:fmd@localhost:5433/fmd

# --- ports ---
API_PORT=8000
WEB_PORT=3000
SEARXNG_PORT=8888
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- crawling posture (be truthful; this is the polite tier) ---
FMD_USER_AGENT=findMyDreamCollege/0.1 (+contact: set-me@example.com)
FMD_DEFAULT_RPS=1
FMD_MAX_PAGES_PER_DOMAIN_PER_DAY=200
FMD_SNAPSHOT_DIR=/data/snapshots

# --- model router: local (vLLM/SGLang, OpenAI-compatible) ---
FMD_LOCAL_LLM_URL=http://host.docker.internal:8000/v1
FMD_LOCAL_LLM_KEY=not-needed

# --- model router: hosted OpenAI-compatible API (adjudication, hard PDFs, NLP) ---
FMD_API_LLM_URL=
FMD_API_LLM_KEY=

# --- model router: Anthropic Messages API and Google Gemini (optional) ---
FMD_ANTHROPIC_URL=https://api.anthropic.com/v1
FMD_ANTHROPIC_KEY=
FMD_GEMINI_URL=https://generativelanguage.googleapis.com/v1beta
FMD_GEMINI_KEY=

# --- per-profile provider/model switches (no YAML edit needed) ---
# Provider names: local | api | anthropic | gemini | mock (see config/models.yaml).
# model= takes the id your provider serves. Defaults are PROVISIONAL until the
# 20-document bake-off in docs/product-development-cycle/10-inference-and-model-selection.md.
FMD_EXTRACT_PROVIDER=local
# Qwen3.5-9B int4, 32k context, thinking disabled (serve it that way; see config).
FMD_EXTRACT_MODEL=Qwen3.5-9B-AWQ
FMD_HARD_PDF_PROVIDER=api
FMD_HARD_PDF_MODEL=
FMD_ADJUDICATE_PROVIDER=gemini
# Documented example: gemini-2.5-flash ($0.30/$2.50 per Mtok, checked 2026-11-16).
# It reroutes to gemini-3.5-flash-lite on 2026-12-01; set either id here.
FMD_ADJUDICATE_MODEL=gemini-2.5-flash
FMD_ENTITY_ADJUDICATE_PROVIDER=local
FMD_ENTITY_ADJUDICATE_MODEL=Qwen3.5-9B-AWQ
FMD_NLP_PROVIDER=gemini
FMD_NLP_MODEL=gemini-2.5-flash
FMD_OCR_PROVIDER=local
FMD_OCR_MODEL=Qwen3-VL-8B-Instruct
FMD_EMBED_PROVIDER=local
FMD_EMBED_MODEL=BAAI/bge-m3

# Working setups (pick one, uncomment, then `fmd llm doctor`):
# 1) Local vLLM/SGLang: serve Qwen3.5-9B-AWQ (bulk) and Qwen3-VL-8B-Instruct (OCR)
#    at FMD_LOCAL_LLM_URL and leave the defaults above.
# 2) OpenAI: FMD_EXTRACT_PROVIDER=api FMD_API_LLM_URL=https://api.openai.com/v1
#            FMD_API_LLM_KEY=<your-token> FMD_EXTRACT_MODEL=gpt-4o-mini
# 3) Anthropic: FMD_EXTRACT_PROVIDER=anthropic FMD_ANTHROPIC_KEY=<your-token>
#               FMD_EXTRACT_MODEL=claude-3-5-sonnet-latest
# 4) Gemini: FMD_EXTRACT_PROVIDER=gemini FMD_GEMINI_KEY=<your-token>
#            FMD_EXTRACT_MODEL=gemini-2.0-flash
# 5) Offline tests: FMD_EXTRACT_PROVIDER=mock (replays recorded fixtures, no network).
# hard_pdf/ocr_vlm are optional: when unset, hard/scanned documents record
# `vision_unavailable` per document and text PDFs still extract.

# --- bake-off (offline, mock provider; never touches the network) ---
# uv run python scripts/bakeoff.py --help
# Prices in a candidates YAML are metadata only; the harness never invents them.

# --- budgets ---
FMD_DAILY_USD_CAP=5
FMD_RUN_USD_CAP=2

# --- review console (single shared token; no user accounts in v1) ---
FMD_ADMIN_TOKEN=change-me
