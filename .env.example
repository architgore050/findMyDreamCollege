# --- database ---
POSTGRES_USER=fmd
POSTGRES_PASSWORD=fmd
POSTGRES_DB=fmd
POSTGRES_PORT=5433
DATABASE_URL=postgresql://fmd:fmd@localhost:5433/fmd

# --- ports ---
API_PORT=8000
WEB_PORT=3000
SEARXNG_PORT=8888
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- crawling posture (be truthful; this is the polite tier) ---
FMD_USER_AGENT=findMyDreamCollege/0.1 (+contact: set-me@example.com)
FMD_DEFAULT_RPS=1
FMD_MAX_PAGES_PER_DOMAIN_PER_DAY=200
FMD_SNAPSHOT_DIR=/data/snapshots

# --- model router: local (llama.cpp `llama-server`, OpenAI-compatible) ---
# One variable, one name. On the host: http://localhost:8010/v1. Inside compose
# the same value works because every client service declares
#   extra_hosts: ["host.docker.internal:host-gateway"]
# (Linux has no host.docker.internal by default). scripts/serve_local.sh serves
# gemma-4-26b-a4b-gguf (Gemma 4 26B-A4B IT, UD-IQ4_XS GGUF, 64k, 8-bit KV cache)
# from MODEL_DIR with llama-server.
FMD_LOCAL_LLM_URL=http://localhost:8010/v1
FMD_LOCAL_LLM_KEY=not-needed

# --- model weights (host disk; never baked into an image or docker volume) ---
# One root holds every weight set; containers mount it read-only at /models.
# Layout:
#   $MODEL_DIR/gemma-4-26B-A4B-it-UD-IQ4_XS/  text GGUF (bulk_extract, verify, entity)
#   $MODEL_DIR/Qwen3.5-9B-AWQ/               superseded text model (reclaim)
#   $MODEL_DIR/gemma-4-12B-it-qat-*          superseded 12B pilots (reclaim)
#   $MODEL_DIR/Qwen3-VL-8B-Instruct-FP8/     optional vision (T2 OCR on :8001)
# Prefetch once with scripts/fetch_model.sh; rebuilds never re-download.
MODEL_DIR=/home/archit-gore/models
# scripts/fetch_model.sh tuning (all optional; defaults shown, safe to leave).
# Optional/absent Hub files never fail: the tree listing decides what is
# required. Diagnose a slow link before blaming retries:
#   scripts/fetch_model.sh speed QuantTrio/Qwen3.5-9B-AWQ
# FMD_MODEL_REVISION=main
# HF_ENDPOINT=https://huggingface.co          # or https://hf-mirror.com
# FMD_MIRROR=https://hf-mirror.com            # probed by `speed`, never auto-used
# FMD_DOWNLOADER=auto                         # auto|curl|aria2 (aria2c if on PATH)
# FMD_ARIA2_CONNECTIONS=8
# FMD_WALL_BUDGET=0                           # seconds; 0 = no global deadline
# FMD_FETCH_ATTEMPTS=10
# FMD_SPEED_LIMIT=10240                       # bytes/s that counts as a stall
# FMD_SPEED_TIME=60                           # seconds below FMD_SPEED_LIMIT
# FMD_BACKOFF_MAX=300
# FMD_SLOW_THRESHOLD=1048576                  # `speed` recommends sneakernet below this
# scripts/serve_local.sh only (not read by the pipeline): separate vLLM venv,
# local path, served name, port, context, GPU reservation.
# FMD_VLLM_VENV=~/.venvs/fmd-vllm
FMD_VLLM_MODEL=/home/archit-gore/models/gemma-4-26B-A4B-it-UD-IQ4_XS/gemma-4-26B-A4B-it-UD-IQ4_XS.gguf
# Must equal scripts/serve_local.sh --alias, or every call 404s.
FMD_SERVED_NAME=gemma-4-26b-a4b-gguf
# The app API publishes host :8000, so the text model is on :8010 (vision :8001).
FMD_VLLM_PORT=8010
# Context: 65536 is measured (runbook §2.8, 2026-11-18) at -b 4096 -ub 2048:
# 15,150 MiB used, 1,153 MiB free. 32k = 14,682 MiB; 96k = 15,684 MiB (fails
# the >=1 GiB rule) and 128k fails to allocate. Pages are 2k-12k tokens, so 64k
# is already ~5x the largest document; raising it buys no decode speed.
FMD_MAX_MODEL_LEN=65536
# MTP speculative decoding (llama.cpp --spec-type draft-mtp). OFF: the parity
# gate could not run because the gemma4-assistant drafter is not on this host
# (the only mtp *.gguf is a qwen4exp-mtp head llama-server rejects). See §2.7 E.
FMD_SPEC=0
# FMD_KV_TYPE=q8_0
# FMD_DRAFT=$MODEL_DIR/gemma-4-26B-A4B-it-UD-IQ4_XS/mtp-gemma-4-26B-A4B-it.gguf
# FMD_NGL=999

# --- model router: hosted OpenAI-compatible API (adjudication, hard PDFs, NLP) ---
FMD_API_LLM_URL=
FMD_API_LLM_KEY=
# Shared fallback model id for every profile whose provider is `api`
# (hard_pdf reads it directly; set it whenever a profile is switched to `api`).
FMD_API_MODEL=

# --- model router: Anthropic Messages API and Google Gemini (optional) ---
FMD_ANTHROPIC_URL=https://api.anthropic.com/v1
FMD_ANTHROPIC_KEY=
FMD_GEMINI_URL=https://generativelanguage.googleapis.com/v1beta
FMD_GEMINI_KEY=

# --- per-profile provider/model switches (no YAML edit needed) ---
# Provider names: local | api | anthropic | gemini | mock (see config/models.yaml).
# model= takes the id your provider serves. Defaults are PROVISIONAL until the
# 20-document bake-off in docs/product-development-cycle/10-inference-and-model-selection.md.
FMD_EXTRACT_PROVIDER=local
# Gemma 4 26B-A4B, UD-IQ4_XS, 64k context, 8-bit KV, thinking disabled in the
# served chat template (scripts/serve_local.sh). Real weights: `probe` must pass.
FMD_EXTRACT_MODEL=gemma-4-26b-a4b-gguf
FMD_HARD_PDF_PROVIDER=api
# hard_pdf is a HOSTED fallback and takes its model from FMD_API_MODEL. Do not
# pair it with a local provider: that would require a model vLLM serves on :8010,
# and local vision is already the acquire T2 stage (Qwen3-VL on :8001), not a
# router profile. FMD_HARD_PDF_MODEL is not read by config/models.yaml.
FMD_ADJUDICATE_PROVIDER=gemini
# Documented example: gemini-2.5-flash ($0.30/$2.50 per Mtok, checked 2026-11-16).
# It reroutes to gemini-3.5-flash-lite on 2026-12-01; set either id here.
FMD_ADJUDICATE_MODEL=gemini-2.5-flash
FMD_ENTITY_ADJUDICATE_PROVIDER=local
FMD_ENTITY_ADJUDICATE_MODEL=Qwen3.5-9B-AWQ
FMD_NLP_PROVIDER=gemini
FMD_NLP_MODEL=gemini-2.5-flash
# --- OCR stage (T2 Qwen3-VL, T2b PaddleOCR-VL) ---
# OCR is an acquisition stage, not a router profile: config/acquire.yaml only
# names the env var, and the tier posts {"pdf_base64":...} to <url>/extract.
# Host default is the compose adapter (profile "ocr"); inside compose it is
# auto-set to http://ocr:8110, so only change this for a remote/host run.
FMD_T2_URL=http://localhost:8110
# URL the *adapter* uses for the host vision vLLM (not the router). Inside
# compose the alias is provided by extra_hosts; on the host use localhost.
FMD_OCR_VLLM_URL=http://host.docker.internal:8001/v1
# T2b (Devanagari fallback, Qwen3-VL-8B behind the same /extract contract).
# Leave empty when it is not deployed: the tier then records TierUnavailable and
# routes the page to the human queue instead of emitting guessed text.
FMD_T2B_URL=
# OCR service knobs (infra/Dockerfile.ocr + infra/ocr/server.py).
FMD_T2_PORT=8110
FMD_OCR_DPI=200
FMD_OCR_DEVICE=gpu:0
FMD_OCR_MAX_PAGES=40
FMD_EMBED_PROVIDER=local
FMD_EMBED_MODEL=BAAI/bge-m3

# Working setups (pick one, uncomment, then `fmd llm doctor`):
# 1) Local vLLM: `scripts/serve_local.sh start` serves Qwen3.5-9B-AWQ at
#    FMD_LOCAL_LLM_URL; leave the defaults above. OCR is separate
#    (`scripts/serve_ocr.sh start`, profile "ocr"), never a router profile.
# 2) OpenAI: FMD_EXTRACT_PROVIDER=api FMD_API_LLM_URL=https://api.openai.com/v1
#            FMD_API_LLM_KEY=<your-token> FMD_EXTRACT_MODEL=gpt-4o-mini
# 3) Anthropic: FMD_EXTRACT_PROVIDER=anthropic FMD_ANTHROPIC_KEY=<your-token>
#               FMD_EXTRACT_MODEL=claude-3-5-sonnet-latest
# 4) Gemini: FMD_EXTRACT_PROVIDER=gemini FMD_GEMINI_KEY=<your-token>
#            FMD_EXTRACT_MODEL=gemini-2.0-flash
# 5) Offline tests: FMD_EXTRACT_PROVIDER=mock (replays recorded fixtures, no network).
# hard_pdf is optional: when unset, hard/scanned documents record
# `vision_unavailable` per document and text PDFs still extract. Scanned pages
# without an OCR endpoint record TierUnavailable and go to the human queue.

# --- bake-off (offline, mock provider; never touches the network) ---
# uv run python scripts/bakeoff.py --help
# Prices in a candidates YAML are metadata only; the harness never invents them.

# --- offline mode (no outbound network) ---
# FMD_OFFLINE=1 forbids every acquisition artifact download. T1 (Docling) then
# uses FMD_DOCLING_ARTIFACTS if it is populated, or fails in <1s with
# `artifacts_unavailable_offline` (routed to T3) instead of stalling in a Hub
# fetch. Tests, DB analysis and cached-artifact acquisition work; model
# downloads, hosted APIs and crawling do not. See docs/.../11-*.md §7.
FMD_OFFLINE=0
# Directory populated once, online, with `docling-tools models download`.
# Leave empty on a networked host; set it for offline T1 extraction.
FMD_DOCLING_ARTIFACTS=
# Belt and braces: these are also set automatically when FMD_OFFLINE=1.
HF_HUB_OFFLINE=0
HF_HUB_DISABLE_TELEMETRY=1

# --- budgets ---
FMD_DAILY_USD_CAP=5
FMD_RUN_USD_CAP=2

# --- review console (single shared token; no user accounts in v1) ---
FMD_ADMIN_TOKEN=change-me

# --- Invisible Playwright MCP browser tier ---
# Third fetch tier: the external invisible-playwright-mcp server over stdio
# (MIT, Python >=3.11), driven by the official mcp SDK. No in-process browser.
# First run downloads the engine; browser_open reports it as cause=downloading.
FMD_BROWSER_MCP_ENABLED=1
FMD_BROWSER_MCP_COMMAND=uvx
# Pinned to the tested version (real-server matrix, 2026-11-27: 0.74.0 passed
# all 20 tools). Override deliberately on upstream upgrades — the opt-in
# integration test (FMD_MCP_INTEGRATION=1) fails loudly on contract drift.
FMD_BROWSER_MCP_ARGS=invisible-playwright-mcp==0.74.0
STEALTHFOX_BINARY=
STEALTHFOX_PROXY=
STEALTHFOX_NO_PROXY=0
STEALTHFOX_PROFILE_DIR=
STEALTHFOX_SEED=
# Headed by default (2026-11-27 real-host finding #3): the server runs on the
# operator's existing display. DISPLAY, XAUTHORITY, WAYLAND_DISPLAY,
# XDG_RUNTIME_DIR and DBUS_SESSION_BUS_ADDRESS are passed through when set.
# Headless needs Xvfb: install xvfb or keep 0 — with =1 and no Xvfb the tier
# fails a preflight naming that fix instead of a bare browser error.
STEALTHFOX_HEADLESS=0
INVISIBLE_MCP_HOME=

# --- Firecrawl Local (FREE; server must run with FIRECRAWL_CLOUD=off) ---
# One Rust binary serving the Firecrawl v2 API locally; no DB/queue/container.
# Start/probe/stop: scripts/firecrawl_local.sh (always sets FIRECRAWL_CLOUD=off).
# The client FAILS CLOSED on any firecrawl-cloud / blocked answer.
FIRECRAWL_LOCAL_ENABLED=0
FIRECRAWL_LOCAL_URL=http://127.0.0.1:3002
FIRECRAWL_LOCAL_TIMEOUT_S=60
FIRECRAWL_CLOUD=off

# --- SearXNG (already in compose; FREE) ---
# verdict-live discovery + the discover stage. Compose maps ${SEARXNG_PORT:-8888}.
SEARXNG_URL=http://127.0.0.1:8888
