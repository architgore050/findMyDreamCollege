# OCR stage service (T2 / T2b). Contract: POST /extract -> {blocks:[...]}.
#
# One Dockerfile, two engines selected by build args:
#
#   vision (default)  python:3.12-slim, no CUDA. Serves Qwen3-VL by calling the
#                     vLLM process on the host over HTTP. vLLM is where the
#                     sm_120 (Blackwell) kernels live; this container has none.
#   paddle            nvidia/cuda base + paddlepaddle-gpu, which tops out at
#                     sm_90. On an RTX 5080 that is "no kernel image is available
#                     for execution on the device"; the compose service pins
#                     FMD_OCR_DEVICE=cpu instead of pretending GPU OCR ran.
#
# NO WEIGHTS ARE DOWNLOADED HERE. The image holds Python, pdfium and server.py
# only. Host weights live under $MODEL_DIR and are bind-mounted read-only at
# /models; the vision engine runs outside Docker. A rebuild is therefore cheap
# and can never trigger a multi-gigabyte fetch or invalidate a cached model.
#
# See docs/product-development-cycle/11-inference-runbook.md §3 for bring-up.
ARG OCR_BASE_IMAGE=python:3.12-slim
FROM ${OCR_BASE_IMAGE}

ARG OCR_REQUIREMENTS=requirements-vision.txt
ARG OCR_APT_PACKAGES=""
# nvidia/cuda images ship python3 without pip/venv; python:3.12-slim has both.
ARG OCR_NEEDS_VENV_PACKAGES=0

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    FMD_OCR_TIER=T2 \
    FMD_OCR_CONFIG=/config/acquire.yaml \
    FMD_MODEL_DIR=/models \
    FMD_OCR_DPI=200

RUN apt-get update \
    && if [ "$OCR_NEEDS_VENV_PACKAGES" = "1" ]; then \
         apt-get install -y --no-install-recommends python3-venv python3-pip; \
       fi \
    && if [ -n "$OCR_APT_PACKAGES" ]; then \
         apt-get install -y --no-install-recommends $OCR_APT_PACKAGES; \
       fi \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

WORKDIR /app
# Build context is the repo root (infra/docker-compose.yml sets `context: ..`).
COPY infra/ocr/${OCR_REQUIREMENTS} /app/requirements.txt
RUN pip install --upgrade pip && pip install -r /app/requirements.txt

COPY infra/ocr/server.py /app/server.py

EXPOSE 8110
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8110"]
