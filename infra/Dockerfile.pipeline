# Pipeline / API / worker image.
#
# Installs the `all` extra (crawl + extract + er) so `fmd crawl` can actually
# fetch, parse PDFs and run entity resolution inside the container. The dev
# group (pytest, ruff) is deliberately excluded from the runtime image.
#
# Serialisation theory is CPU-only: torch/torchvision are pulled from the
# PyTorch CPU index and the CUDA/nvidia/triton wheels are filtered out of the
# lockfile export. No CUDA, no vLLM (brief §15, §21). The model router talks to
# an external OpenAI-compatible endpoint instead.
#
# Build context is the repository root:
#   docker compose -f infra/docker-compose.yml build api
#
# Layer cache: pyproject.toml + uv.lock are copied before the source tree, so a
# source-only edit only re-runs the final `pip install --no-deps .` layer.

# syntax=docker/dockerfile:1.7

ARG PYTHON_VERSION=3.12

FROM python:${PYTHON_VERSION}-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.12.22 /uv /usr/local/bin/uv

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never \
    UV_NO_PROGRESS=1

# A compiler is only needed if a dependency has no manylinux wheel for the
# architecture. Wheels cover the full `all` extra on x86_64 today.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Dependency graph only: this layer survives every source change.
COPY packages/pipeline/pyproject.toml packages/pipeline/uv.lock packages/pipeline/README.md ./

# Export the frozen lockfile once, minus the dev group. CUDA wheels are dropped
# because torch comes from the CPU index below; keeping them would add several
# GB of nvidia-* packages that this image can never use.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv export --frozen --no-dev --extra all --no-emit-project --no-hashes \
      | grep -vE '^(torch==|triton==|nvidia-|cuda-)' > /tmp/requirements.txt \
    && uv venv /opt/venv --python 3.12

# CPU-only torch first, so torchvision/sentence-transformers/docling see an
# installed torch==2.15.0 and do not pull the default CUDA wheel from PyPI.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /opt/venv/bin/python \
        --index-url https://download.pytorch.org/whl/cpu \
        "torch==2.15.0"

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /opt/venv/bin/python -r /tmp/requirements.txt

# The package itself: no deps (already installed), non-editable so the image
# still runs if /app is not bind-mounted.
COPY packages/pipeline /build
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /opt/venv/bin/python --no-deps .

FROM python:${PYTHON_VERSION}-slim AS runtime

ARG VCS_REF=unknown
LABEL org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.title="findMyDreamCollege pipeline"

# Only runtime shared libraries: libgomp1 for torch, glib for opencv-headless,
# tini for correct signal handling of uvicorn/worker children.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libgomp1 \
        libglib2.0-0 \
        tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 fmd \
    && useradd --uid 10001 --gid fmd --create-home --shell /usr/sbin/nologin fmd

ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    VIRTUAL_ENV=/opt/venv \
    FMD_CONFIG_DIR=/config \
    FMD_MIGRATIONS_DIR=/db/migrations \
    FMD_SNAPSHOT_DIR=/data/snapshots

COPY --from=builder /opt/venv /opt/venv
COPY infra/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

COPY packages/pipeline /app
COPY config /config
COPY db /db

RUN chmod 0755 /usr/local/bin/docker-entrypoint.sh \
    && mkdir -p /data/snapshots \
    && chown -R fmd:fmd /app /data /config /db

USER fmd
WORKDIR /app

EXPOSE 8000

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/docker-entrypoint.sh"]
CMD ["uvicorn", "fmd.api:app", "--host", "0.0.0.0", "--port", "8000"]
