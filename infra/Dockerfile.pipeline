# Pipeline/API image. Base deps only: no ML extras (brief §15, §21).
# Build context is the repository root:
#   docker compose -f infra/docker-compose.yml build api

FROM python:3.12-slim AS runtime

COPY --from=ghcr.io/astral-sh/uv:0.12.22 /uv /usr/local/bin/uv

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_NO_CACHE=1 \
    PYTHONPATH=/app \
    FMD_CONFIG_DIR=/config \
    FMD_MIGRATIONS_DIR=/db/migrations \
    FMD_SNAPSHOT_DIR=/data/snapshots

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 fmd \
    && useradd --uid 10001 --gid fmd --create-home --shell /usr/sbin/nologin fmd

# Install runtime deps before copying the source tree so edits invalidate less.
COPY packages/pipeline/pyproject.toml packages/pipeline/README.md /tmp/pipeline/
RUN uv pip install --system --no-cache \
        "pydantic>=2.7,<3" \
        "pydantic-settings>=2.3,<3" \
        "psycopg[binary,pool]>=3.2,<4" \
        "PyYAML>=6.0.1,<7" \
        "httpx>=0.27,<1" \
        "python-dateutil>=2.9,<3" \
        "fastapi>=0.115,<1" \
        "uvicorn[standard]>=0.30,<1"

COPY packages/pipeline /app
COPY config /config
COPY db /db

RUN uv pip install --system --no-cache --no-deps /app \
    && mkdir -p /data/snapshots \
    && chown -R fmd:fmd /app /data /config /db

USER fmd
WORKDIR /app

EXPOSE 8000
CMD ["uvicorn", "fmd.api:app", "--host", "0.0.0.0", "--port", "8000"]
